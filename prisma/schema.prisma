// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECRUITER
  CANDIDATE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum Currency {
  INR
  USD
  EUR
  GBP
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  OFFERED
  REJECTED
  HIRED
}

model User {
  id              String    @id @default(cuid())
  fullName        String
  email           String    @unique
  password        String
  phoneNumber     String?   @unique
  role            Role
  profileImage    String?
  emailVerifiedAt DateTime?

  jobs         Job[]         @relation("JobsCreated")
  applications Application[]
  resumes      Resume[]
  certificates Certificate[]

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id      String  @id @default(cuid())
  name    String
  email   String  @unique
  website String?
  address String
  about   String?
  logo    String?

  recruiters User[]
  jobs       Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id String @id @default(cuid())

  title       String
  description String

  salaryMin Int?
  salaryMax Int?
  currency  String? @default("INR")

  location String

  skillRequirements String

  numberOfOpenings Int @default(1)

  applicationDeadline DateTime?

  applications Application[]

  employmentType EmploymentType

  status JobStatus @default(OPEN)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdById String
  createdBy   User   @relation("JobsCreated", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Application {
  id String @id @default(cuid())

  candidateId String
  candidate   User   @relation(fields: [candidateId], references: [id])

  jobId String
  job   Job    @relation(fields: [jobId], references: [id])

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id])

  status ApplicationStatus @default(APPLIED)

  coverLetter String?

  notes     String?
  interview Interview?

  appliedAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([candidateId, jobId])
}

model Resume {
  id String @id @default(cuid())

  title String

  summary String?

  resumeUrl String?

  linkedinUrl String?

  githubUrl String?

  candidateId String
  candidate   User   @relation(fields: [candidateId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  experiences        Experience[]
  educations         Education[]
  resumeCertificates ResumeCertificate[]

  applications Application[]
  projects     Project[]
}

model Experience {
  id String @id @default(cuid())

  companyName String

  jobTitle String

  location String

  description Json?

  startDate DateTime

  endDate DateTime?

  currentlyWorking Boolean @default(false)

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([resumeId, companyName, jobTitle, startDate])
}

model Education {
  id String @id @default(cuid())

  degree String

  fieldOfStudy String?

  instituteName String

  grade String?

  startDate DateTime

  endDate DateTime?

  currentlyStudying Boolean @default(false)

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Certificate {
  id String @id @default(cuid())

  title String

  issuer String

  issueDate DateTime?

  expiryDate DateTime?

  credentialId String?

  credentialUrl String?

  candidateId String
  candidate   User   @relation(fields: [candidateId], references: [id])

  resumeLinks ResumeCertificate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ResumeCertificate {
  resumeId      String
  certificateId String

  resume Resume @relation(fields: [resumeId], references: [id])

  certificate Certificate @relation(fields: [certificateId], references: [id])

  @@id([resumeId, certificateId])
}

model Interview {
  id String @id @default(cuid())

  applicationId String @unique

  application Application @relation(fields: [applicationId], references: [id])

  scheduledAt DateTime

  mode String

  meetingLink String?

  interviewerName String

  feedback String?

  result String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Project {
  id String @id @default(cuid())

  title       String
  description String?

  githubUrl String?
  liveUrl   String?

  techStack String?

  startDate DateTime?
  endDate   DateTime?

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
